---
import MainLayout from '../../layouts/MainLayout.astro';
import directory from '../../data/directory.json';
    
export async function getStaticPaths() {
    return directory.map((restaurant) => ({
        params: { slug: restaurant.slug },
        props: { restaurant },
    }));
}

const { restaurant } = Astro.props;

// Fetch Google Places Photo
let imageUrl = restaurant.images && restaurant.images.length > 0 ? restaurant.images[0] : 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80';
let secondImageUrl = 'https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&w=600&q=80';
let thirdImageUrl = 'https://images.unsplash.com/photo-1544148103-0773bf10d330?auto=format&fit=crop&w=600&q=80';

const apiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;
if (apiKey) {
    try {
        const query = encodeURIComponent(`${restaurant.name} London`);
        const searchUrl = `https://maps.googleapis.com/maps/api/place/findplacefromtext/json?input=${query}&inputtype=textquery&fields=photos&key=${apiKey}`;
        const response = await fetch(searchUrl);
        const data = await response.json();
        
        if (data.candidates && data.candidates.length > 0 && data.candidates[0].photos) {
            const photos = data.candidates[0].photos;
            if (photos.length > 0) {
                imageUrl = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=1200&photo_reference=${photos[0].photo_reference}&key=${apiKey}`;
            }
            if (photos.length > 1) {
                secondImageUrl = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=600&photo_reference=${photos[1].photo_reference}&key=${apiKey}`;
            }
            if (photos.length > 2) {
                thirdImageUrl = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=600&photo_reference=${photos[2].photo_reference}&key=${apiKey}`;
            }
        }
    } catch (error) {
        console.error("Error fetching from Google Places API for " + restaurant.name, error);
    }
}
---

<MainLayout title={restaurant.name}>
    <main class="max-w-6xl mx-auto px-4 md:px-8 py-8">
        <!-- Hero Header -->
        <header class="mb-10">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6">
                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <span class="font-sans text-xs font-semibold uppercase tracking-[0.05em] text-primary bg-card border border-border rounded-full px-3 py-1">{restaurant.cuisine}</span>
                        {restaurant.tags.slice(0, 1).map((tag) => (
                             <span class="font-sans text-xs font-semibold uppercase tracking-[0.05em] text-primary bg-card border border-border rounded-full px-3 py-1">{tag}</span>
                        ))}
                    </div>
                    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-[-0.02em] text-primary mb-2">
                        {restaurant.name}
                    </h1>
                    <div class="flex items-center gap-2 font-sans text-muted">
                        <span class="flex items-center text-action">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                        </span>
                        <span class="font-semibold text-primary">{restaurant.rating > 0 ? restaurant.rating : "New"}</span>
                        <span>(Google Reviews)</span>
                        <span class="mx-2">•</span>
                        <span>{restaurant.price_range}</span>
                    </div>
                </div>
            </div>

            <!-- Hero Image Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[40vh] md:h-[50vh]">
                <div class="md:col-span-2 h-full min-h-0 rounded-2xl overflow-hidden bg-gray-200">
                    <img src={imageUrl} alt={`${restaurant.name} Interior`} class="w-full h-full object-cover">
                </div>
                <div class="hidden md:flex flex-col gap-4 h-full min-h-0">
                    <div class="flex-1 min-h-0 rounded-2xl overflow-hidden bg-gray-200">
                        <img src={secondImageUrl} alt={`${restaurant.name} Food`} class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 min-h-0 rounded-2xl overflow-hidden bg-gray-200 relative group cursor-pointer" onclick="triggerAction(event, 'Gallery', 'Opening full photo gallery')">
                        <img src={thirdImageUrl} alt={`${restaurant.name} Drinks`} class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-primary/40 flex items-center justify-center transition-opacity group-hover:bg-primary/50">
                            <span class="text-white font-sans font-medium">+ Photos</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Two Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            
            <!-- Left Column: Editorial & Details -->
            <div class="lg:col-span-2">
                
                <!-- Editorial Review -->
                <section class="mb-12">
                    <h2 class="font-display text-2xl mb-4 text-primary">The Curated Review</h2>
                    <div class="font-sans text-lg text-primary leading-relaxed space-y-6 whitespace-pre-wrap">
                        {restaurant.full_profile}
                    </div>
                </section>

                <hr class="border-border my-10">

                <!-- Highlights / Tags -->
                <section class="mb-12">
                    <h2 class="font-display text-2xl mb-6 text-primary">Highlights</h2>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 font-sans text-sm text-primary">
                        {restaurant.tags.map((tag) => (
                            <div class="flex items-center gap-3">
                                <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                {tag}
                            </div>
                        ))}
                    </div>
                </section>

            </div>

            <!-- Right Column: Sticky Utility Sidebar -->
            <aside class="lg:col-span-1 relative">
                <div class="sticky top-24 bg-card border border-border rounded-2xl p-6 shadow-sm">
                    
                    <!-- Booking Action -->
                    <div class="mb-8">
                        <h3 class="font-sans font-semibold text-lg mb-2">Book a Table</h3>
                        <p class="font-sans text-sm text-muted mb-4">Select a time to reserve your spot. Walk-ins are also welcome but expect a wait.</p>
                        <button onclick="triggerAction(event, 'Booking Requested', 'Connecting to reservation system...')" class="w-full bg-action text-white font-sans font-semibold py-3 px-4 rounded-xl hover:bg-opacity-90 transition-all shadow-md hover:shadow-lg cursor-pointer">
                            Find a Table
                        </button>
                    </div>

                    <hr class="border-border my-6">

                    <!-- Location details -->
                    <div class="mb-6">
                        <h3 class="font-sans font-semibold text-base mb-3">Location</h3>
                        <p class="font-sans text-sm text-muted mb-4 leading-relaxed">
                            {restaurant.city}, {restaurant.country}
                        </p>
                        <!-- Faux Map Box -->
                        <div class="w-full h-32 bg-[#e5e3df] rounded-lg border border-border relative overflow-hidden flex items-center justify-center cursor-pointer group" onclick="triggerAction(event, 'Map Opened', 'Launching Google Maps')">
                            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(var(--color-muted) 1px, transparent 1px); background-size: 10px 10px;"></div>
                            <div class="w-4 h-4 bg-action rounded-full border-2 border-white shadow-md z-10 group-hover:scale-125 transition-transform"></div>
                            <span class="absolute bottom-2 right-2 font-sans text-[10px] bg-card px-2 py-1 rounded text-primary">View Map</span>
                        </div>
                    </div>

                    <!-- Facilities -->
                    <div>
                        <h3 class="font-sans font-semibold text-base mb-3">Facilities</h3>
                        <ul class="font-sans text-sm text-muted space-y-2">
                            {restaurant.facilities.map((fac) => (
                                <li class="flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
                                    {fac}
                                </li>
                            ))}
                        </ul>
                    </div>

                </div>
            </aside>

        </div>
    </main>
</MainLayout>
